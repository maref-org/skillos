{
  // SkillOS 治理框架约束（独立文件，不被 OpenCode schema 校验）
  "constitution_ref": "../CONSTITUTION.md",
  "governance_ref": "GOVERNANCE.md",
  "security_redlines": {
    "title": "安全红线 — 仓库远程隔离",
    "rules": [
      "git remote -v 必须仅显示授权远程",
      "禁止添加非授权 remote",
      "禁止 git push 到非授权远程",
      "禁止 gh CLI 推送到非授权 remote",
      "禁止绕过 pre-push hook"
    ]
  },
  "governance_supremacy": true,
  "security_redlines_extra": [
    "remote必须仅显示授权remote",
    "禁止绕过pre-push hook (--no-verify)",
    "禁止提交专有工作文件",
    "禁止gh CLI推送到非授权远程",
    "CD pipeline (cd.yml)必须禁用",
    "Agent启动时须验证remote为授权remote"
  ],
  "workspace_switch_rules": {
    "private_dev_workspace": "执行完整预检",
    "external_workspace": "适用Art.32 + Art.9，不适用remote检查",
    "subagent_transfer": "任务指令须含第三十条 + 第四-A条"
  },
  "document_source_hierarchy": {
    "L0": "内部知识库架构文档（权威源）",
    "L1": "public/skillos/docs/（代码配套）",
    "L2": "GitHub公开仓库（仅对外确认）",
    "priority": "L0 > L1 > L2"
  }
}
